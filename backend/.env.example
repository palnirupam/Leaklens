# --- LeakLens backend configuration ---
# Copy this file to backend/.env and fill in your values.

# Gemini API integration. All three are optional.
# If GEMINI_API_KEY is empty, LeakLens runs fully offline (rule-based mode).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# If true, sanitized analysis metadata (column names, aggregated stats) may be sent to Gemini.
# Full datasets and private code are NEVER sent, regardless of this flag.
ALLOW_DATA_TO_GEMINI=false

# Backend server (keep 127.0.0.1 unless you set API_KEY below)
HOST=127.0.0.1
PORT=8000

# Shared API token. When set, all /api routes (except /api/health) require the
# X-API-Key header. If left empty, authentication is disabled AND the server
# refuses to start on a non-loopback interface (so it cannot be exposed to the
# network without a key). For the frontend to use the token, set the same value
# in frontend/.env.local as VITE_API_KEY=...
API_KEY=

# Storage root for uploaded datasets, DB, and reports (relative to backend/).
STORAGE_DIR=../data/leaklens
